---
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../config/site';

interface Props {
  showWordmark?: boolean;
}

const { showWordmark = true } = Astro.props;
---
<header class="site-header">
  {showWordmark ? (
    <a class="site-wordmark" href="/" aria-label={`${site.wordmark}, home`}>{site.wordmark}</a>
  ) : <span aria-hidden="true"></span>}
  <ThemeToggle />
</header>
