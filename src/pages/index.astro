---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteNavigation from "../components/SiteNavigation.astro";
import { site } from "../config/site";

const currentYear = new Date().getFullYear();
---

<BaseLayout
    title={site.name}
    description={site.description}
    showWordmark={false}
    canonicalPath="/"
>
    <main class="home-shell">
        <section class="identity-block" aria-label="Introduction">
            <img
                class="profile-image"
                src={site.profileImage}
                alt={site.profileImageAlt}
                width="84"
                height="84"
                fetchpriority="high"
            />
            <div class="identity-copy">
                <h1 class="identity-name">{site.name}</h1>
                <p class="identity-tagline">{site.tagline}</p>
            </div>
        </section>

        <div class="home-copy">
            <p>
                Hey, I’m Animesh. I am a CS student who likes to tinker around
                with different technologies. Right now I am totally locked in on
                ML and Systems Engineering, actively applying what I learn by
                building projects.
            </p>

            <p>
                I also to watch football ( Ronaldo fan ofc ) and like writing a
                lot, as it helps me to express myself better. Most things that I
                learn, I write about them in my notes and a few of them turn
                into blogs. My interests move around, but the common thread is
                figuring out how things work and building something useful with
                that understanding.
            </p>

            <p>
                This is my corner of the internet for projects, writing, and
                ideas I’m still working through. I’m open to interesting
                collaborations and projects. You can find my code on{" "}
                <a href={site.githubUrl} rel="noreferrer">
                    GitHub
                </a>{" "}
                or browse my{" "}
                <a href={site.notesUrl}>notes</a>, where I collect ideas while
                I am still working through them.
            </p>
            {site.resumeUrl && (
                <p>
                    My <a href={site.resumeUrl}>résumé</a> is available here.
                </p>
            )}
            {site.email && (
                <p>
                    For work or collaborations, email me at{" "}
                    <a href={`mailto:${site.email}`}>{site.email}</a>.
                </p>
            )}
        </div>

        <SiteNavigation />

        <footer class="home-footer">
            <span>{site.location}</span>
            <span class="footer-separator" aria-hidden="true">
                ·
            </span>
            <time
                id="local-clock"
                aria-label={`Local time in ${site.timezoneLabel}`}
            >
                IST
            </time>
        </footer>
        <p class="copyright">
            © {currentYear} {site.name}
        </p>
    </main>

    <script
        define:vars={{
            timezone: site.timezone,
            timezoneLabel: site.timezoneLabel,
        }}
    >
        const clock = document.getElementById("local-clock");
        const updateClock = () => {
            if (!clock) return;
            const time = new Intl.DateTimeFormat("en-IN", {
                hour: "2-digit",
                minute: "2-digit",
                hour12: true,
                timeZone: timezone,
            })
                .format(new Date())
                .toUpperCase();
            clock.textContent = `${time} ${timezoneLabel}`;
        };
        updateClock();
        const intervalId = window.setInterval(updateClock, 60_000);
        document.addEventListener(
            "astro:before-swap",
            () => window.clearInterval(intervalId),
            { once: true },
        );
    </script>
</BaseLayout>
