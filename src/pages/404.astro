---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="This page does not exist.">
  <main class="page-shell not-found-shell">
    <a class="back-link" href="/">← back home</a>
    <header class="page-intro">
      <h1 class="page-title">404</h1>
      <p class="page-deck">Looks like this page got lost somewhere.</p>
      <p class="page-note"><a href="/blog/">Head back to the blog</a> or return to the home page.</p>
    </header>
  </main>
</BaseLayout>
